{
  "name": "langclarity",
  "displayName": "LangClarity",
  "description": "Editable structured-English interpretations for TypeScript and JavaScript. Explicit bidirectional sync via Codex with diff review.",
  "version": "0.0.1",
  "publisher": "langclarity",
  "icon": "assets/appicons/icon-128.png",
  "license": "MIT",
  "preview": true,
  "homepage": "https://github.com/charlestol/LangClarity",
  "repository": {
    "type": "git",
    "url": "https://github.com/charlestol/LangClarity.git"
  },
  "keywords": [
    "codex",
    "code explanation",
    "natural language programming",
    "typescript",
    "javascript",
    "react",
    "markdown",
    "sync"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "LangClarity sends explicitly requested source and English to Codex/OpenAI, so the workspace must be trusted."
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:langclarity.openEnglishView",
    "onCommand:langclarity.interpretFile",
    "onCommand:langclarity.englishToCode",
    "onCommand:langclarity.codeToEnglish",
    "onCommand:langclarity.selectModel",
    "onCommand:langclarity.openMarkdown",
    "onCommand:langclarity.addToGitignore",
    "onCustomEditor:langclarity.interpretationView",
    "workspaceContains:**/.langclarity/**/*.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "langclarity.openEnglishView",
        "title": "Open Interpretation",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.interpretFile",
        "title": "Interpret File",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.englishToCode",
        "title": "English → Code",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.codeToEnglish",
        "title": "Code → English",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.selectModel",
        "title": "Select Codex Model and Reasoning",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.openMarkdown",
        "title": "Open Interpretation Markdown",
        "category": "LangClarity"
      },
      {
        "command": "langclarity.addToGitignore",
        "title": "Add .langclarity to .gitignore",
        "category": "LangClarity"
      }
    ],
    "submenus": [
      {
        "id": "langclarity.sourceActions",
        "label": "LangClarity"
      },
      {
        "id": "langclarity.explorerSourceActions",
        "label": "LangClarity"
      }
    ],
    "customEditors": [
      {
        "viewType": "langclarity.interpretationView",
        "displayName": "LangClarity Interpretation",
        "selector": [
          {
            "filenamePattern": "**/.langclarity/**/*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "langclarity.openEnglishView",
          "when": "(editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact) && langclarity.activeHasInterpretation"
        },
        {
          "command": "langclarity.interpretFile",
          "when": "(editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact) && !langclarity.activeHasInterpretation"
        },
        {
          "command": "langclarity.englishToCode",
          "when": "((editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact) && langclarity.activeHasInterpretation) || activeCustomEditorId == langclarity.interpretationView"
        },
        {
          "command": "langclarity.codeToEnglish",
          "when": "((editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact) && langclarity.activeHasInterpretation) || activeCustomEditorId == langclarity.interpretationView"
        },
        {
          "command": "langclarity.selectModel",
          "when": "editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact"
        },
        {
          "command": "langclarity.openMarkdown",
          "when": "activeCustomEditorId == langclarity.interpretationView"
        }
      ],
      "editor/context": [
        {
          "submenu": "langclarity.sourceActions",
          "when": "editorLangId == typescript || editorLangId == typescriptreact || editorLangId == javascript || editorLangId == javascriptreact",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "langclarity.explorerSourceActions",
          "when": "resourceExtname == .ts || resourceExtname == .tsx || resourceExtname == .js || resourceExtname == .jsx",
          "group": "navigation@20"
        }
      ],
      "langclarity.sourceActions": [
        {
          "command": "langclarity.openEnglishView",
          "when": "langclarity.activeHasInterpretation",
          "group": "1_open@10"
        },
        {
          "command": "langclarity.interpretFile",
          "when": "!langclarity.activeHasInterpretation",
          "group": "1_open@20"
        },
        {
          "command": "langclarity.codeToEnglish",
          "when": "langclarity.activeHasInterpretation",
          "group": "2_sync@10"
        },
        {
          "command": "langclarity.englishToCode",
          "when": "langclarity.activeHasInterpretation",
          "group": "2_sync@20"
        },
        {
          "command": "langclarity.selectModel",
          "group": "3_settings@10"
        }
      ],
      "langclarity.explorerSourceActions": [
        {
          "command": "langclarity.openEnglishView",
          "when": "resourcePath in langclarity.interpretedSourcePaths",
          "group": "1_open@10"
        },
        {
          "command": "langclarity.interpretFile",
          "when": "!(resourcePath in langclarity.interpretedSourcePaths)",
          "group": "1_open@20"
        },
        {
          "command": "langclarity.codeToEnglish",
          "when": "resourcePath in langclarity.interpretedSourcePaths",
          "group": "2_sync@10"
        },
        {
          "command": "langclarity.englishToCode",
          "when": "resourcePath in langclarity.interpretedSourcePaths",
          "group": "2_sync@20"
        },
        {
          "command": "langclarity.selectModel",
          "group": "3_settings@10"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "benchmark:fidelity": "npm run compile && vscode-test --grep \"Fidelity corpus\"",
    "corpus:fidelity": "npm run compile && node out/fidelity/printCorpus.js",
    "package:vsix": "vsce package"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
