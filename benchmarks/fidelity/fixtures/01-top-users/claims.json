{
  "id": "01-top-users",
  "languageId": "typescript",
  "sourceFile": "source.ts",
  "mustHave": [
    {
      "id": "filters-active-us",
      "description": "Keeps only active users whose country is US.",
      "patterns": ["(?i)active", "(?i)\\bUS\\b"]
    },
    {
      "id": "sorts-by-score-desc",
      "description": "Orders by score, highest first.",
      "patterns": ["(?i)score", "(?i)high|descend|highest|top"]
    },
    {
      "id": "default-limit-10",
      "description": "Default limit is 10 when not provided.",
      "patterns": ["(?i)\\b10\\b"]
    },
    {
      "id": "empty-when-nonpositive-limit",
      "description": "Returns an empty list when limit is zero or negative.",
      "patterns": ["(?i)empty|none|\\[\\]|no (?:user|people)", "(?i)0|zero|negative|<=\\s*0|less"]
    }
  ],
  "prohibited": [
    {
      "id": "mutates-input-users",
      "description": "Must not claim the input users array is mutated in place.",
      "patterns": [
        "(?i)mutat(?:e|es|ing|ion).*(?:input|original|users?\\s+array)",
        "(?i)(?:change|modify|overwrite)s?\\s+(?:the\\s+)?(?:input|original)\\s+users?"
      ]
    }
  ]
}
